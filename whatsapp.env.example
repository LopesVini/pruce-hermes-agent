# Copy to whatsapp.env (ignored by git). No account authentication data here.
WHATSAPP_ENABLED=false
# Vinicius's PERSONAL sender number, country code + DDD + number, digits only.
# This is NOT the Claro bot number. Keep empty until known; empty denies all.
WHATSAPP_ALLOWED_USERS=
# Same sender's DM JID, e.g. 55DDDNUMBER@s.whatsapp.net. No groups.
# RU uses the actual originating chat; this is only the default for other jobs.
WHATSAPP_HOME_CHANNEL=
